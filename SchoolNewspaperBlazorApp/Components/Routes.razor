@using Microsoft.AspNetCore.Components.Authorization
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView
                RouteData="routeData"
                DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                RouteData="routeData"
                DefaultLayout="typeof(Layout.MainLayout)"
                <p>Nie masz uprawień do tej strony</p>
                <p> href="/login"> Pdzejdz do logowania    </p>
            </NotAuthorized>
        </AuthorizeRouteView>

    </Found>
</Router>
