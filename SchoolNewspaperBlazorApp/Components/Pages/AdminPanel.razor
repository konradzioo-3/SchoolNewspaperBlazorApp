@page "/adminPanel"
@rendermode InteractiveServer
@inject IArticleService articleService
@inject INotificationService NotifyService
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service

<div class="admin-page">

    <section class="admin-header">
        <div class="admin-header__content">
            <span class="admin-header__eyebrow">
                ETI / STREFA ZARZĄDZANIA
            </span>

            <h1>Panel administratora</h1>

            <p>
                Zarządzaj publikacjami i użytkownikami gazetki szkolnej
                w jednym miejscu.
            </p>

            <div class="admin-header__status">
                <span class="site-status__dot"></span>
                Centrum zarządzania gazetką
            </div>
        </div>

        <div class="admin-header__emblem" aria-hidden="true">
            <img src="/logo.png" alt="" />
        </div>
    </section>

    @if (view == 0)
    {
        <div class="admin-section-heading">
            <div>
                <span class="admin-section-heading__eyebrow">
                    MENU GŁÓWNE
                </span>
                <h2>Co chcesz zrobić?</h2>
                <p>Wybierz jedną z dostępnych funkcji panelu.</p>
            </div>
        </div>

        <div class="admin-actions">
            @if (Permissions[EnumPermissions.EditArticle] || Permissions[EnumPermissions.Master])
            {
            <button type="button"
                    class="admin-action"
                    @onclick="LoadArticleAsync">

                <span class="admin-action__icon">▤</span>

                <span class="admin-action__number">01</span>

                <strong>Panel artykułów</strong>

                <span class="admin-action__description">
                    Przeglądaj publikacje i zarządzaj istniejącymi artykułami.
                </span>

                <span class="admin-action__footer">
                    Otwórz artykuły <span>→</span>
                </span>
            </button>
            }
            @if (Permissions[EnumPermissions.AddArticle] || Permissions[EnumPermissions.Master])
            {
            <button type="button"
                    class="admin-action"
                    @onclick="() => SetView(2)">

                <span class="admin-action__icon">✎</span>

                <span class="admin-action__number">02</span>

                <strong>Dodaj artykuł</strong>

                <span class="admin-action__description">
                    Przygotuj nową publikację i dodaj ją do gazetki szkolnej.
                </span>

                <span class="admin-action__footer">
                    Utwórz artykuł <span>→</span>
                </span>
            </button>
            }
            @if (Permissions[EnumPermissions.AddUser] || Permissions[EnumPermissions.Master])
            { 
            <button type="button"
                    class="admin-action"
                    @onclick="() => SetView(3)">

                <span class="admin-action__icon">♙</span>

                <span class="admin-action__number">03</span>

                <strong>Dodaj użytkownika</strong>

                <span class="admin-action__description">
                    Dodaj konto użytkownika do systemu gazetki.
                </span>

                <span class="admin-action__footer">
                    Dodaj konto <span>→</span>
                </span>
            </button>
            } 
            @if (Permissions[EnumPermissions.Master])
            {
                <button type="button"
                class="admin-action"
                    @onclick="() => SetView(5)">

                <span class="admin-action__icon">✎</span>

                <span class="admin-action__number">04</span>

                <strong>Nadaj uprawnienia</strong>

                <span class="admin-action__description">
                    Ustaw uprawniena użytkownikowi.
                </span>

                <span class="admin-action__footer">
                    Nadaj uprawnienia <span>→</span>
                </span>
            </button>
            }
            @if (Permissions[EnumPermissions.ManageUser] || Permissions[EnumPermissions.Master])
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(6)">

                    <span class="admin-action__icon">☰</span>

                    <span class="admin-action__number">05</span>

                    <strong>Użytkownicy</strong>

                    <span class="admin-action__description">
                        Przeglądaj konta, zmieniaj stanowiska i usuwaj użytkowników.
                    </span>

                    <span class="admin-action__footer">
                        Zarządzaj kontami <span>→</span>
                    </span>
                </button>
            }
            @if (Permissions[EnumPermissions.ManageUser] || Permissions[EnumPermissions.Master])
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(7)">

                    <span class="admin-action__icon">✚</span>

                    <span class="admin-action__number">06</span>

                    <strong>Role</strong>

                    <span class="admin-action__description">
                        Dodawaj nowe role (stanowiska), które można przypisać użytkownikom.
                    </span>

                    <span class="admin-action__footer">
                        Dodaj rolę <span>→</span>
                    </span>
                </button>
            }
            @if (Permissions[EnumPermissions.AddSubstituteLesson] || Permissions[EnumPermissions.Master])
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(8)">

                    <span class="admin-action__icon">✎</span>

                    <span class="admin-action__number">07</span>

                    <strong>Zastępstwo</strong>

                    <span class="admin-action__description">
                        Dodawaj Zastępstwo (Zastępstwa)
                    </span>

                    <span class="admin-action__footer">
                        Dodaj Zastępstwo <span>→</span>
                    </span>
                </button>
            }
            @if (CanManageSchoolData || Permissions[EnumPermissions.Master])
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(9)">

                    <span class="admin-action__icon">▦</span>

                    <span class="admin-action__number">08</span>

                    <strong>Dane szkolne</strong>

                    <span class="admin-action__description">
                        Klasy, nauczyciele, sale i przedmioty używane w zastępstwach.
                    </span>

                    <span class="admin-action__footer">
                        Zarządzaj danymi <span>→</span>
                    </span>
                </button>
            }
            @if (Permissions[EnumPermissions.ManageCustomFields] || Permissions[EnumPermissions.Master])
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(10)">

                    <span class="admin-action__icon">✚</span>

                    <span class="admin-action__number">09</span>

                    <strong>Pola formularza</strong>

                    <span class="admin-action__description">
                        Własne pola w formularzu zastępstw, widoczne na liście.
                    </span>

                    <span class="admin-action__footer">
                        Dodaj pola <span>→</span>
                    </span>
                </button>
            }
        </div>

        <section class="admin-section">
            <div class="admin-section__title-row">
                <span class="admin-section__symbol">✦</span>
                <div>
                    <h2>Witaj w centrum zarządzania</h2>
                    <p>
                        Wybierz odpowiednią kartę powyżej, aby rozpocząć pracę.
                    </p>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="admin-back-row">
            <button type="button"
                    class="admin-back-button"
                    @onclick="() => SetView(0)">
                <span>←</span> Wróć do panelu
            </button>

            <div class="admin-current-view">
                <span class="site-status__dot"></span>

                @if (view == 1)
                {
                    <span>Zarządzanie artykułami</span>
                }
                else if (view == 2)
                {
                    <span>Tworzenie artykułu</span>
                }
                else if (view == 3)
                {
                    <span>Dodawanie użytkownika</span>
                }
                else if(view == 5)
                {
                    <span>Nadawanie uprawnien</span>

                }
                else if (view == 6)
                {
                    <span>Zarządzanie użytkownikami</span>
                }
                else if (view == 7)
                {
                    <span>Dodawanie ról</span>
                }
                else if (view == 8)
                {
                    <span>Dodawanie Zastępstw</span>
                }
                else if (view == 9)
                {
                    <span>Dane szkolne</span>
                }
                else if (view == 10)
                {
                    <span>Pola formularza zastępstw</span>
                }
            </div>
        </div>

        @if (view == 1)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            PUBLIKACJE
                        </span>
                        <h2>Panel artykułów</h2>
                        <p>Zarządzaj artykułami opublikowanymi w gazetce.</p>
                    </div>

                    <button type="button"
                            class="admin-small-button"
                            @onclick="() => SetView(2)">
                        + Dodaj artykuł
                    </button>
                </div>

                @if (articleList.Count == 0)
                {
                    <div class="admin-empty-state">
                        <span class="admin-empty-state__icon">▤</span>
                        <h3>Brak artykułów</h3>
                        <p>
                            Nie znaleziono publikacji. Możesz dodać pierwszy
                            artykuł do gazetki.
                        </p>

                        <button type="button"
                                class="admin-small-button"
                                @onclick="() => SetView(2)">
                            Dodaj pierwszy artykuł
                        </button>
                    </div>
                }
                else
                {
                    <div class="article-panel">
                        <ArticleCard Articles="articleList"
                                     permissions="true"
                                     OnEdit="LoadArticleToEditAsync"
                                     CanDelete="Permissions[EnumPermissions.DeleteArticle]" />
                    </div>
                }
            </section>
        }
        else if (view == 2)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            NOWA PUBLIKACJA
                        </span>
                        <h2>Dodaj artykuł</h2>
                        <p>Uzupełnij formularz, aby przygotować publikację.</p>
                    </div>
                </div>

                <div class="admin-form-wrapper">
                    <AddArticleForm IsEdit="false" ClearView="() => SetView(0)" />
                </div>
            </section>
        }
        else if (view == 3)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            KONTA
                        </span>
                        <h2>Dodaj użytkownika</h2>
                        <p>Utwórz nowe konto w systemie gazetki.</p>
                    </div>
                </div>

                <div class="admin-form-wrapper">
                    <AddUserForm ClearView="() => SetView(0)"  />
                </div>
            </section>
        }
        else if(view == 4)
        {
            <AddArticleForm IsEdit="true" Article="articleToEdit" ClearView="() => SetView(0)" />

        }
        else if(view == 5)
        {
            <AsignUserPermissionCard/>
        }
        else if (view == 6)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            KONTA
                        </span>
                        <h2>Użytkownicy</h2>
                        <p>Zmieniaj stanowiska i usuwaj konta użytkowników gazetki.</p>
                    </div>
                </div>

                <ManageUserCard />
            </section>
        }
        else if (view == 7)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            ROLE
                        </span>
                        <h2>Role</h2>
                        <p>Dodaj nową rolę. Pojawi się na liście stanowisk przy tworzeniu i edycji użytkowników.</p>
                    </div>
                </div>

                <AddRoleForm />
            </section>
        }
        else if (view == 8)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            ZASTĘPSTWA
                        </span>
                        <h2>Zastępstwa</h2>
                        <p>Dodaj nowe zastępstwo. Pojawi się w zakładce „Zastępstwa” na stronie głównej.</p>
                    </div>
                </div>

                <AddSubstitudeForm />
            </section>
        }
        else if (view == 9)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            SŁOWNIKI
                        </span>
                        <h2>Dane szkolne</h2>
                        <p>Klasy, nauczyciele, sale i przedmioty. Pojawią się jako listy wyboru w formularzu zastępstw.</p>
                    </div>
                </div>

                <SchoolDataPanel />
            </section>
        }
        else if (view == 10)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            FORMULARZ
                        </span>
                        <h2>Pola formularza zastępstw</h2>
                        <p>Dodaj własne pola. Pojawią się w formularzu, a opcjonalnie także na liście zastępstw.</p>
                    </div>
                </div>

                <CustomFieldManager />
            </section>
        }
    }

    </div>

@code {
    [SupplyParameterFromQuery(Name = "notification")]
    public string? Notification { get; set; }
    [Inject]
    public IPermissionService permissionService { get; set; } = null!;
    public int view = 0;
    private bool CanManageSchoolData =>
        Permissions[EnumPermissions.ManageClasses]
        || Permissions[EnumPermissions.ManageTeachers]
        || Permissions[EnumPermissions.ManageRooms]
        || Permissions[EnumPermissions.ManageSubjects];
    public List<Article> articleList = new List<Article>();
    public Article? articleToEdit;
    private Dictionary<EnumPermissions, bool> Permissions 
     = Enum.GetValues<EnumPermissions>()
    .ToDictionary(p => p, p => false);
    protected override async Task OnInitializedAsync()
    {
        Permissions = await permissionService.GetAllPermissionsAsync();
    }

    protected override void OnParametersSet()
    {
        if (Notification == "login")
        {
            NotifyService.Show(
                "Logowanie powiodło się!",
                EnumNotificationType.Success
            );
        }
    }

    public void SetView(int view)
    {
        this.view = view;
    }
    public async Task LoadArticleAsync()
    {
        articleList = await articleService.GetLatestArticlesAsync();
        SetView(1);
    }
    public async Task LoadArticleToEditAsync(int id)
    {
        articleToEdit = await articleService.GetArticleByIdAsync(id);
        SetView(4);
    }
}