@page "/"
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService;

<PageTitle>Gazetka ETI</PageTitle>

<section class="home-hero">
    <button @onclick="() => articleService.GetLatestArticlesAsync()">Najnowsze</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Announcements)">Ogłoszenia</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Substitute)">Zastępstwa</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Events)">Wydarzenia</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Competitions)">Konkursy</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Admisions)">Rekrutacja</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.Exams)">Egzaminy</button>
    <button @onclick="() => GetCategoryArticle(EnumArticleType.StudentsCouncil)">Samorząd</button>
</section>

<div class="section-heading" id="aktualnosci">
    <div>
        <h2>Najnowsze artykuły</h2>
        <p>Świeże wiadomości od redakcji gazetki.</p>
    </div>
</div>

<ArticleCard Articles="articles" permissions="false" />


@code 
{
    public List<Article> articles = new List<Article>();
    protected override async Task OnInitializedAsync()
    {
        articles = await articleService.GetLatestArticlesAsync();
    }
    public async Task GetCategoryArticle(EnumArticleType type)
    {
        articles.Clear();
        articles = await articleService.GetAllArticleByTypeAsync(type);
    }
}