@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Interfaces.Service


<PageTitle>@(article?.Title ?? "Artykuł") - Gazetka ETI</PageTitle>

@if (_loading)
{
    <div class="article-page" aria-busy="true">
        <div class="skeleton skeleton--image"></div>
        <div class="skeleton skeleton--title"></div>
        <div class="skeleton skeleton--line"></div>
        <div class="skeleton skeleton--line"></div>
    </div>
}
else if (article == null)
{
    <div class="admin-empty-state">
        <span class="admin-empty-state__icon">?</span>
        <h3>Nie znaleziono artykułu</h3>
        <p>Ten artykuł nie istnieje albo został usunięty.</p>
        <a href="/" class="btn btn-primary">Wróć na stronę główną</a>
    </div>
}
else
{
    <article class="article-page">

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }

        <h1 class="article-page__title">@article.Title</h1>

        @if (_isLegacy)
        {
            @* Starszy artykuł bez bloków: najpierw tekst, a pod nim zdjęcia z galerii (scalone w kolaż) *@
            <div class="article-page__content">
                @article.Text
            </div>
        }

        @* Treść z bloków: tekst i zdjęcia w kolejności ustalonej przez autora; kolejne zdjęcia scalają się w kolaż *@
        <ArticleBlocksView Items="blocks" AltText="@article.Title" />

        <div class="article-page__meta">
            <span class="article-page__author">@article.Author</span>
            @if (!string.IsNullOrWhiteSpace(article.AuthorRole))
            {
                <span class="article-page__role">@article.AuthorRole</span>
            }
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;
    private bool _loading = true;
    private bool _isLegacy;
    private int _loadedId = -1;
    private List<BlockViewItem> blocks = new();

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    // OnParametersSetAsync, bo przejście z /article/1 na /article/2 używa tego samego komponentu.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _loading = true;
        article = null;
        imageUrl = null;
        blocks = new List<BlockViewItem>();
        _isLegacy = false;

        try
        {
            article = await articleService.GetArticleByIdAsync(Id);
        }
        catch (Exception)
        {
            // Brak artykułu pokazujemy jako czytelny komunikat zamiast pustej strony.
            article = null;
        }

        if (article != null)
        {
            var fileName = await fileService.TryGetFileNameByIdAsync(article.MainImageId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }

            var items = new List<BlockViewItem>();
            foreach (var saved in await articleService.GetBlocksAsync(article.Id))
            {
                if (saved.BlockType == EnumArticleBlockType.Text)
                {
                    if (!string.IsNullOrWhiteSpace(saved.Text))
                    {
                        items.Add(new BlockViewItem { Text = saved.Text });
                    }
                }
                else if (saved.MediaFileId is int mediaId)
                {
                    var name = await fileService.TryGetFileNameByIdAsync(mediaId);
                    if (name != null)
                    {
                        items.Add(new BlockViewItem { IsImage = true, ImageUrl = $"/Images/{name}", InCollage = saved.InCollage });
                    }
                }
            }

            if (items.Count == 0)
            {
                _isLegacy = true;
                // Starszy artykuł: zdjęcia z galerii też scalamy w kolaż.
                foreach (var file in await fileService.GetGalleryFileNamesByIdAsync(article.Id))
                {
                    items.Add(new BlockViewItem { IsImage = true, ImageUrl = $"/Images/{file}" });
                }
            }
            blocks = items;
        }
        _loading = false;
    }
}
