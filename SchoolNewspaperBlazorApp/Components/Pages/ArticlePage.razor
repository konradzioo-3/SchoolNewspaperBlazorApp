@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service


@if (article != null)
{
    <article class="article-page">

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }

        <h1 class="article-page__title">@article.Title</h1>


        <div class="article-page__content">
            @article.Text
        </div>

        <div class="article-page__meta">
            <span class="article-page__author">@article.Author</span>
        </div>
        @foreach(var galeryImage in GalleryImmageNames)
        {
        <div class="article-page__img-wrap">
            <img src="@galeryImage" alt="@article.Title" class="article-page__img" />
        </div>
        }
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;
    public List<string> GalleryImmageNames { get; set; } = new();

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        article = await articleService.GetArticleByIdAsync(Id);

        if (article != null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(article.MainImageId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }
            var files = await fileService.GetGalleryFileNamesByIdAsync(article.Id);
            foreach(var file in files)
            {
                GalleryImmageNames.Add($"/Images/{file}");
            }

        }
    }
}