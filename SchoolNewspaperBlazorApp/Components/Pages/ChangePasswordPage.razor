@page "/zmiana-hasla"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IAuthService AuthService
@inject IPermissionService PermissionService
@inject INotificationService NotifyService
@inject NavigationManager Nav

<PageTitle>Zmiana hasła | Gazetka ETI</PageTitle>

@if (_allowed)
{
    <div class="password-page">
        <div class="password-card">
            <span class="password-card__icon" aria-hidden="true">🔒</span>

            <h1>Ustaw własne hasło</h1>
            <p class="password-card__lead">
                To Twoje pierwsze logowanie. Hasło nadane przez administratora jest tymczasowe -
                wybierz własne, aby przejść dalej. Zrobisz to tylko raz.
            </p>

            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <label class="form-label" for="pw-current">Hasło tymczasowe</label>
                <input id="pw-current" type="password" class="form-control mb-3" autocomplete="current-password"
                       @bind="_current" required />

                <label class="form-label" for="pw-new">Nowe hasło</label>
                <input id="pw-new" type="password" class="form-control mb-1" autocomplete="new-password"
                       @bind="_new" @bind:event="oninput" required />
                <ul class="password-rules">
                    <li class="@(_new.Length >= 8 ? "is-ok" : "")">min. 8 znaków</li>
                    <li class="@(_new.Any(char.IsLetter) ? "is-ok" : "")">co najmniej jedna litera</li>
                    <li class="@(_new.Any(char.IsDigit) ? "is-ok" : "")">co najmniej jedna cyfra</li>
                </ul>

                <label class="form-label" for="pw-confirm">Powtórz nowe hasło</label>
                <input id="pw-confirm" type="password" class="form-control mb-4" autocomplete="new-password"
                       @bind="_confirm" @bind:event="oninput" required />

                <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Zapisz hasło</button>
            </form>
        </div>
    </div>
}

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;
    private bool _allowed;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var userId = await PermissionService.GetUserId();
        _allowed = await AuthService.MustChangePasswordAsync(userId);
        if (!_allowed)
        {
            // Hasło zmienia się tylko przy pierwszym logowaniu - wszyscy inni wracają na stronę główną.
            Nav.NavigateTo("/", replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (await AuthService.ChangePasswordAsync(_current, _new, _confirm))
            {
                // Pełne przeładowanie - układ strony odczyta nowy stan konta.
                Nav.NavigateTo("/adminPanel?notification=login", forceLoad: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
